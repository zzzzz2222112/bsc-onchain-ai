DEPLOYER_PRIVATE_KEY=
# Preferred mainnet mode: delegate signing to Foundry's encrypted keystore CLI.
CLI_SIGNER=false
# Deprecated compatibility alias; local unlocked nodes only, never a public RPC.
UNLOCKED_DEPLOYER=false
DEPLOYER=
PROTOCOL_OWNER=
TREASURY=
COMPONENT_BASE_URI=ipfs://tinyai/{id}.json

# Full protocol deployment uses DeployFullProtocol.s.sol. Keep all real signer
# and RPC credentials outside this file and outside Git.

# Token Mode prelaunch: mine a future CA locally, deploy and bind TinyAI, then create the token last.
# NVDAB (NVIDIA) is both the Flap quote token and the AI-holder reward asset.
FLAP_QUOTE_TOKEN=0x02Fca66C1D1aFB4E2A7884261eB00F63598a7436
HOLDER_VAULT=
FLAP_PORTAL=0xe2ce6ab80874fa9fa2aae65d277dd6b8e65c9de0
FLAP_TOKEN_NAME=
FLAP_TOKEN_SYMBOL=
FLAP_TOKEN_META=
FLAP_TOKEN_SALT=
FLAP_SALT_LOCK_FEE=10000000000000000
FLAP_BUY_TAX_BPS=100
FLAP_SELL_TAX_BPS=100
# 36500 days. Confirm the live Portal maximum again before any broadcast.
FLAP_TAX_DURATION=3153600000
FLAP_ANTI_FARMER_DURATION=0
FLAP_INITIAL_QUOTE_AMOUNT=0
FLAP_CALL_VALUE=1000000000

# Fill with the mined future ...7777 CA before deploying the Token Mode stack.
PAYMENT_TOKEN=
BRAIN_REGISTRY=0x29eefcc07ea38535a16fe4fb9c9469d4634c1fa1
AI_MINT_PRICE=500000000000000000000
COMPONENT_MINT_PRICE=500000000000000000000
CHAT_PRICE=0

# Legacy paid-classifier deployment variables retained for compatibility.
LIQUIDITY_RECIPIENT=
COMMUNITY_RECIPIENT=
DEPLOY_TOKEN=true
TOKEN_NAME=TinyAI Token
TOKEN_SYMBOL=TAI
FEE_PER_CHAT=10000000000000000000
BURN_BPS=2500
